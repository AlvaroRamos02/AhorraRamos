# Optional. The server binds to localhost only.
PORT=3000
DATA_DIR=./data

# Optional recipient of outgoing transfers treated as stock contributions.
INVESTMENT_TRANSFER_RECIPIENT=

# Enable Banking AIS for ING Spain. Keep the downloaded private key outside this repository.
# The redirect URL must be registered with Enable Banking and stay local.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=
ENABLE_BANKING_REDIRECT_URL=https://127.0.0.1:3000/api/banking/ing/callback
LOCAL_TLS_KEY_PATH=
LOCAL_TLS_CERT_PATH=
